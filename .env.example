# Frontend Environment Variables (Vite / Vercel)
# In production on Vercel, set VITE_API_URL to your Render backend URL (e.g. https://job-portal-api.onrender.com)
VITE_API_URL=http://localhost:3001
VITE_APP_NAME=Job Portal
VITE_APP_VERSION=1.0.0

# NOTE: Backend database credentials, JWT secrets, and server configuration
# MUST NEVER be placed in this frontend environment file.
# Configure backend variables in backend/.env or your Render dashboard.

# ========================================================
# Job Portal Backend Environment Configuration
# ========================================================

# Server Configuration
PORT=3001
NODE_ENV=production

# --------------------------------------------------------
# Database Configuration (Managed MySQL / Remote DB)
# --------------------------------------------------------
# Option A: Connection URI (e.g. Render, Railway, Aiven)
# DATABASE_URL=mysql://username:password@hostname:3306/dbname?ssl-mode=REQUIRED

# Option B: Discrete Parameters
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_database_password
DB_NAME=job_portal

# SSL Configuration for Managed MySQL
# Set DB_SSL=true when using managed MySQL (Aiven, Render, PlanetScale, AWS RDS)
DB_SSL=true
# Set to false if using self-signed CA certificates from the cloud provider without custom CA bundle
DB_SSL_REJECT_UNAUTHORIZED=false
# Optional: Path or inline string for custom SSL CA certificate
# DB_SSL_CA=

# Database Auto-Creation
# Set to false in production (managed MySQL instances are pre-provisioned)
DB_AUTO_CREATE=false

# --------------------------------------------------------
# Authentication / JWT Configuration
# --------------------------------------------------------
# Critical: Must be at least 16 characters long and non-trivial
JWT_SECRET=generate_a_secure_random_secret_at_least_32_chars_long
JWT_EXPIRE=30d

# --------------------------------------------------------
# CORS Configuration (Allowed Frontend Origins)
# --------------------------------------------------------
# Set FRONTEND_URL to your Vercel deployment domain
FRONTEND_URL=https://your-job-portal.vercel.app

# Optional: Additional comma-separated allowed origins (e.g. preview deployments)
# ALLOWED_ORIGINS=https://preview-deployments.vercel.app,http://localhost:5173

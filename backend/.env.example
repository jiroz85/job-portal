# Database Configuration (MySQL / MariaDB)
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=job_portal

# Server Configuration
PORT=3001
NODE_ENV=development

# JWT Security Configuration (Must be at least 16 characters)
JWT_SECRET=replace_with_a_secure_jwt_secret_key_at_least_16_chars
JWT_EXPIRE=30d

# Frontend Allowed Origins (CORS)
# Multiple origins can be comma-separated: http://localhost:5173,https://your-domain.vercel.app
FRONTEND_URL=http://localhost:5173
